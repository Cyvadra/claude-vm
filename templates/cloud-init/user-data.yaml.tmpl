#cloud-config
# 由 lib/render.py 產生，勿手改。
#
# 前置條件：VM 開機時 approx-gateway.service 必須已運行，
# 否則 apt 與 Claude Code 安裝都會失敗（客體沒有其他出網路徑）。

hostname: @@GUEST_HOSTNAME@@
manage_etc_hosts: true
timezone: @@GUEST_TZ@@

users:
  - name: @@GUEST_USER@@
    # uid 必須與宿主檔案擁有者一致，virtiofs 的 passthrough 模式才能正確映射
    uid: @@GUEST_UID@@
    groups: [sudo]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    lock_passwd: true
    # 第一筆永遠是宿主→該台的管理金鑰；guest.ssh_keys=scan 時
    # 會再接上宿主 ~/.ssh/*.pub 掃到的公鑰。
    ssh_authorized_keys:
@@SSH_AUTHORIZED_KEYS@@

ssh_pwauth: false
disable_root: true

package_update: true
packages:
  - git
  - curl
  - ca-certificates
  - jq
  - unzip
  - less
  - vim
  - tmux
  - htop
  - rsync
  # Claude Code 執行期依賴
  - ripgrep
  - build-essential
  - python3
  - python3-pip
  - python3-venv
  - openssh-server
  # 工具鏈：與宿主對齊
  - gh
  - docker.io

write_files:
  - path: /etc/fstab
    append: true
    content: |
@@FSTAB_LINES@@

  # Go 環境檔：由部署時偵測宿主 `go env` 產生，確保客體行為與宿主一致。
  # 只寫入與家目錄無關的鍵；路徑類由 profile.d 與掛載點決定。
  # 寫到 /etc 再 install 到使用者目錄：write_files 執行時客體使用者
  # 可能還沒建立，直接指定 owner 會失敗（getpwnam: name not found）
  - path: /etc/claude-vm/go-env
    permissions: '0644'
    content: |
@@GO_ENV_FILE@@

  # git 身分：每台 VM 一份，刻意不沿用宿主，避免 commit 帶出可識別身分
  - path: /etc/claude-vm/gitconfig
    permissions: '0644'
    content: |
@@GIT_CONFIG@@

  # conda 設定：沿用宿主的鏡像
  - path: /etc/claude-vm/condarc
    permissions: '0644'
    content: |
@@CONDARC@@

  # npm registry：沿用宿主的鏡像設定
  - path: /etc/claude-vm/npmrc
    permissions: '0644'
    content: |
@@NPMRC@@

  # 讓 127.0.0.1 上的宿主服務端口直通閘道。
  # 共用 ~/workspace 的設定檔寫的是 127.0.0.1，兩邊都要成立。
  - path: /etc/claude-vm/localfwd.nft
    permissions: '0644'
    content: |
      table ip localfwd
      delete table ip localfwd
      table ip localfwd {
          chain out {
              type nat hook output priority -100; policy accept;
              ip daddr 127.0.0.1 tcp dport { @@LOCALFWD_PORTS@@ } dnat to @@GATEWAY@@
          }
          chain post {
              type nat hook postrouting priority 100; policy accept;
              # 只改寫轉發出去的服務流量。用 saddr 判斷會誤傷
              # systemd-resolved 從 loopback 發出的 DNS 查詢，導致解析全掛。
              ip daddr @@GATEWAY@@ tcp dport { @@LOCALFWD_PORTS@@ } masquerade
          }
      }

  - path: /etc/systemd/system/localfwd.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Forward 127.0.0.1 host-service ports to the gateway
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/sbin/nft -f /etc/claude-vm/localfwd.nft
      ExecStop=-/usr/sbin/nft delete table ip localfwd

      [Install]
      WantedBy=multi-user.target

  # 客體自己的對外 SSH 金鑰（給 GitHub 等服務用），與宿主無關。
  # 宿主→客體的管理金鑰由 cloud-init 的 ssh_authorized_keys 注入。
  - path: /etc/claude-vm/gen-ssh-key.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      K=/home/@@GUEST_USER@@/.ssh/id_ed25519
      [ -f "$K" ] && exit 0
      install -d -o @@GUEST_USER@@ -g @@GUEST_USER@@ -m 0700 /home/@@GUEST_USER@@/.ssh
      sudo -u @@GUEST_USER@@ -H ssh-keygen -t ed25519 -N '' \
        -C '@@SSH_KEY_COMMENT@@' -f "$K"

  # 工具鏈與快取全部由宿主共享（virtiofs），客體不安裝也不重複佔用磁碟。
  # 路徑與宿主一致，所以 Go 與 npm 的預設值直接可用。
  - path: /etc/profile.d/claude-vm-toolchain.sh
    permissions: '0644'
    content: |
      export GOROOT=/usr/local/go
      export GOPATH=$HOME/go
      export GOMODCACHE=$HOME/go/pkg/mod
      export GOCACHE=$HOME/.cache/go-build
      export PATH=$GOROOT/bin:$GOPATH/bin:$HOME/.local/bin:$PATH
      export NVM_DIR=$HOME/.nvm
      [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
      [ -x "$HOME/miniconda3/bin/conda" ] && . "$HOME/miniconda3/etc/profile.d/conda.sh"

  # 預設關閉 Claude Code 的全部遙測與非必要流量。
  # 寫進 settings.json 的 env 區塊：登入與非登入 shell 都生效，不依賴 profile.d。
  # CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC 是總開關，會一併關掉 feature flag
  # 評估與 Remote Control；這是刻意的取捨。
  # 注意：這只關遙測。推理請求本身的 metadata.user_id 不受任何開關影響。
  - path: /etc/claude-vm/claude-settings.json
    permissions: '0644'
    content: |
      {
        "env": {
          "DISABLE_TELEMETRY": "1",
          "DISABLE_ERROR_REPORTING": "1",
          "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
          "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
          "DISABLE_FEEDBACK_COMMAND": "1",
          "DISABLE_BUG_COMMAND": "1"
        },
        "cleanupPeriodDays": 7
      }

  - path: /etc/profile.d/claude-vm-telemetry.sh
    permissions: '0644'
    content: |
      # 與 ~/.claude/settings.json 的 env 同步。profile.d 不涵蓋非登入 shell，
      # 兩邊都寫是為了讓任何啟動路徑的行為一致。
      export DISABLE_TELEMETRY=1
      export DISABLE_ERROR_REPORTING=1
      export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
      export CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1
      export DISABLE_FEEDBACK_COMMAND=1
      export DISABLE_BUG_COMMAND=1

runcmd:
  - [bash, -c, "@@MOUNT_MKDIR@@"]
  - [bash, -c, "chown -R @@GUEST_USER@@:@@GUEST_USER@@ /home/@@GUEST_USER@@"]
  - [systemctl, daemon-reload]
  - [bash, -c, "mount -a || true"]

  - [bash, -c, "install -o @@GUEST_USER@@ -g @@GUEST_USER@@ -m 0644 /etc/claude-vm/gitconfig /home/@@GUEST_USER@@/.gitconfig"]
  - [bash, -c, "install -o @@GUEST_USER@@ -g @@GUEST_USER@@ -m 0644 /etc/claude-vm/npmrc /home/@@GUEST_USER@@/.npmrc"]
  - [bash, -c, "install -o @@GUEST_USER@@ -g @@GUEST_USER@@ -m 0644 /etc/claude-vm/condarc /home/@@GUEST_USER@@/.condarc"]
  - [bash, -c, "sysctl -w net.ipv4.conf.all.route_localnet=1"]
  - [systemctl, enable, --now, localfwd.service]
  - [/etc/claude-vm/gen-ssh-key.sh]

  # 非登入 shell（ssh host cmd、腳本）不會載入 profile.d，
  # 用 /usr/local/bin 的符號連結讓 go 在任何 PATH 下都能用
  - [ln, -sf, /usr/local/go/bin/go, /usr/local/bin/go]
  - [ln, -sf, /usr/local/go/bin/gofmt, /usr/local/bin/gofmt]

  # 把 Go 環境檔放到定位並修正擁有者
  - [bash, -c, "install -d -o @@GUEST_USER@@ -g @@GUEST_USER@@ /home/@@GUEST_USER@@/.config/go"]
  - [bash, -c, "install -o @@GUEST_USER@@ -g @@GUEST_USER@@ -m 0644 /etc/claude-vm/go-env /home/@@GUEST_USER@@/.config/go/env"]

  # docker：讓使用者免 sudo
  - [bash, -c, "usermod -aG docker @@GUEST_USER@@ || true"]

  # kubectl：直接取官方二進位（失敗不中斷整段佈建）
  - |
    curl -fsSL --connect-timeout 10 --max-time 180 -o /usr/local/bin/kubectl \
      "https://dl.k8s.io/release/$(curl -fsSL --connect-timeout 10 --max-time 30 https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" \
      && chmod +x /usr/local/bin/kubectl \
      || echo "kubectl 安裝失敗，稍後可手動補"

  # conda：安裝一份獨立 Miniconda（宿主的 anaconda3 在另一顆碟、160G，
  # 不適合共享；既有 env 無法複製，需要時另外掛載）
  - |
    if [ ! -x /home/@@GUEST_USER@@/miniconda3/bin/conda ]; then
      curl -fsSL --connect-timeout 10 --max-time 300 -o /tmp/mc.sh https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh \
        && bash /tmp/mc.sh -b -p /home/@@GUEST_USER@@/miniconda3 \
        && chown -R @@GUEST_USER@@:@@GUEST_USER@@ /home/@@GUEST_USER@@/miniconda3 \
        || echo "miniconda 安裝失敗，稍後可手動補"
    fi

  # Claude Code 原生安裝（自帶執行期，不需 Node.js）
  # 先把關閉遙測的 settings.json 放好，讓第一次啟動就生效。
  - [bash, -c, "install -d -o @@GUEST_USER@@ -g @@GUEST_USER@@ -m 0700 /home/@@GUEST_USER@@/.claude"]
  - [bash, -c, "install -o @@GUEST_USER@@ -g @@GUEST_USER@@ -m 0644 /etc/claude-vm/claude-settings.json /home/@@GUEST_USER@@/.claude/settings.json"]
  - sudo -u @@GUEST_USER@@ -H bash -lc 'curl -fsSL --connect-timeout 10 --max-time 120 https://claude.ai/install.sh | bash'

  - sudo -u @@GUEST_USER@@ -H bash -lc 'claude --version'

final_message: "claude-vm ready after $UPTIME seconds"
