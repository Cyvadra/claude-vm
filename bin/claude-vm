#!/usr/bin/env bash
# claude-vm — 部署走透明代理的 Claude Code 虛擬機（可多台）
#
# 用法：bin/claude-vm <command> [args]
# 執行 bin/claude-vm help 看完整清單。
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RENDER="$ROOT/lib/render.py"
CONFIG="$ROOT/config.yaml"
OUT="$ROOT/.state/rendered"
KEYS="$ROOT/.state/keys"
LOCK="$ROOT/.state/lock"

# sudo 的 secure_path 可能把 python3 指向沒有 PyYAML 的直譯器，逐一探測
pick_python() {
  local cand
  for cand in python3 /usr/bin/python3 python3.13 python3.12 python3.11 python3.10; do
    if command -v "$cand" >/dev/null 2>&1 && "$cand" -c 'import yaml' 2>/dev/null; then
      command -v "$cand"; return 0
    fi
  done
  return 1
}
PYTHON="$(pick_python)" || { echo "error: 找不到含 PyYAML 的 python3" >&2; exit 1; }

die()  { echo "error: $*" >&2; exit 1; }
info() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
require_root() { [[ ${EUID:-$(id -u)} -eq 0 ]] || die "需要 root：sudo $0 $*"; }

# 兩個 bin/claude-vm 同時跑會互相清掉渲染產物
with_lock() {
  mkdir -p "$(dirname "$LOCK")"
  exec 9>"$LOCK"
  flock -n 9 || die "另一個 claude-vm 正在執行（$LOCK）"
}

do_render() { "$PYTHON" "$RENDER" --config "$CONFIG" "$@"; }

load_global() {
  [[ -f $CONFIG ]] || die "找不到 $CONFIG，先執行：$0 init"
  eval "$(do_render --env)"
}

# 把某台 VM 的變數載入當前 shell：VM_NAME VM_MAC VM_MAC_MODE VM_IP DISK_PATH SEED_PATH
# REDIR_PORT TPROXY_PORT DNS_PORT CONTROLLER UPSTREAM_HOST UPSTREAM_PORT
load_vm() {
  eval "$(do_render --env --only "$1")"
}

vm_names() { do_render --list | cut -f1; }

# 只有一台時可省略名稱；多台時必須指明
resolve_vm() {
  local want="${1:-}"
  if [[ -n $want ]]; then
    vm_names | grep -qx "$want" || die "找不到 VM：$want（可用：$(vm_names | paste -sd' ')）"
    printf '%s' "$want"
    return
  fi
  local all
  all="$(vm_names)"
  local count
  count="$(printf '%s\n' "$all" | grep -c . || true)"
  [[ $count -eq 1 ]] || die "有多台 VM，請指定名稱：$(echo "$all" | paste -sd' ')"
  printf '%s' "$all"
}

# IP 是 DHCP 靜態保留值；不要按 MAC 查租約，因為 `mac: random` 僅在初始化時產生。
vm_ip() {
  local name="$1"
  load_vm "$name"
  printf '%s' "$VM_IP"
}

random_mac() {
  # 02 is locally administered + unicast.  Do not use QEMU's 52:54:00 OUI.
  local bytes
  bytes="$(openssl rand -hex 5)" || die "無法產生隨機 MAC（需要 openssl）"
  printf '02:%s:%s:%s:%s:%s' "${bytes:0:2}" "${bytes:2:2}" "${bytes:4:2}" \
         "${bytes:6:2}" "${bytes:8:2}"
}

# 每台 VM 一份 known_hosts。共用宿主的 ~/.ssh/known_hosts 會有兩個問題：
# 一是污染使用者自己的檔案，二是 DHCP 位址換手時會撞到舊主機金鑰。
vm_ssh() {
  local name="$1"; shift
  local ip
  ip="$(vm_ip "$name")"
  [[ -n $ip ]] || return 1
  ssh -i "$KEYS/$name" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=5 \
      -o StrictHostKeyChecking=no -o UserKnownHostsFile="$KEYS/$name.known_hosts" \
      "$GUEST_USER@$ip" "$@"
}

require_rendered() { [[ -d $OUT/shared ]] || die "尚未渲染，先執行：$0 render"; }

# ── init ────────────────────────────────────────────────────────────
cmd_init() {
  if [[ -f $CONFIG ]]; then
    die "$CONFIG 已存在。要重新開始請先移走它。"
  fi
  cp "$ROOT/config.example.yaml" "$CONFIG"
  chmod 600 "$CONFIG"
  info "已建立 $CONFIG"
  echo "請編輯後執行：$0 check"
}

# ── check ───────────────────────────────────────────────────────────
cmd_check() {
  load_global
  local fail=0
  ok()  { printf '  \033[32m✓\033[0m %s\n' "$*"; }
  bad() { printf '  \033[31m✗\033[0m %s\n' "$*"; fail=1; }

  info "主機前置條件"
  local bin
  for bin in virsh qemu-img cloud-localds nft sysctl python3 ssh-keygen openssl; do
    command -v "$bin" >/dev/null && ok "$bin" || bad "$bin 不存在"
  done
  python3 -c 'import yaml' 2>/dev/null && ok "python3-yaml" || bad "缺少 python3-yaml"

  [[ -w /dev/kvm ]] && ok "/dev/kvm 可用" || bad "/dev/kvm 不可用（VM 無法啟動）"
  systemctl is-active --quiet libvirtd && ok "libvirtd 運行中" || bad "libvirtd 未運行"
  [[ -x /usr/lib/qemu/virtiofsd ]] && ok "virtiofsd" || bad "virtiofsd 不存在"
  [[ -x $CORE_BIN ]] && ok "核心: $CORE_BIN" || bad "核心不存在或不可執行：$CORE_BIN"

  info "設定檔"
  if do_render --check >/dev/null; then ok "config 結構與路徑"; else bad "config 驗證失敗"; fi

  info "網段衝突"
  local conflicts
  conflicts="$(ip -o -4 route show | python3 -c "
import sys, ipaddress
sub = ipaddress.ip_network('$SUBNET_CIDR')
bridge = '$BRIDGE'
bad = []
for line in sys.stdin:
    # 自家網橋的路由不算衝突，否則重跑 check 會永遠失敗
    if f'dev {bridge} ' in line:
        continue
    line = line.split()[0].strip()
    if not line or line == 'default':
        continue
    try:
        n = ipaddress.ip_network(line, strict=False)
    except ValueError:
        continue
    if n.version == 4 and n.overlaps(sub):
        bad.append(str(n))
print(' '.join(sorted(set(bad))))
")"
  [[ -z $conflicts ]] && ok "$SUBNET_CIDR 無衝突" || bad "$SUBNET_CIDR 與既有網段重疊：$conflicts"

  info "連接埠與上游（逐台）"
  # 網關已運行時，埠位必然被自家實例佔用——這是預期狀態，不該判失敗。
  local gateway_live=0
  if systemctl is-active --quiet approx-gateway.service 2>/dev/null \
     || systemctl list-units --state=active --no-legend 'approx-gateway@*.service' 2>/dev/null | grep -q .; then
    gateway_live=1
    printf '  \033[33m-\033[0m 網關運行中，埠位檢查略過（重新部署時會重啟）\n'
  fi
  local name
  for name in $(vm_names); do
    load_vm "$name"
    if timeout 5 bash -c "cat < /dev/null > /dev/tcp/$UPSTREAM_HOST/$UPSTREAM_PORT" 2>/dev/null; then
      ok "$name: 上游 $UPSTREAM_HOST:$UPSTREAM_PORT 可連"
    else
      bad "$name: 上游 $UPSTREAM_HOST:$UPSTREAM_PORT 連不上"
    fi
    local p
    if [[ $gateway_live -eq 0 ]]; then
      for p in "$REDIR_PORT" "$TPROXY_PORT" "$DNS_PORT" "${CONTROLLER##*:}"; do
        if ss -tln "sport = :$p" 2>/dev/null | grep -q LISTEN; then
          bad "$name: port $p 已被佔用"
        else
          ok "$name: port $p 空閒"
        fi
      done
    fi
  done

  info "儲存"
  mkdir -p "$DISK_DIR" 2>/dev/null || true
  [[ -w $DISK_DIR ]] && ok "$DISK_DIR 可寫" || bad "$DISK_DIR 不可寫"

  info "資源"
  local vcpu_sum mem_sum host_cpu host_mem
  vcpu_sum=0; mem_sum=0
  for name in $(vm_names); do
    load_vm "$name"
    vcpu_sum=$((vcpu_sum + VCPU)); mem_sum=$((mem_sum + MEM_GB))
  done
  host_cpu="$(nproc)"; host_mem="$(( $(awk '/MemTotal/{print $2}' /proc/meminfo) / 1024 / 1024 ))"
  printf '  %-10s %s vCPU / %s GiB（宿主 %s vCPU / %s GiB）\n' "合計" "$vcpu_sum" "$mem_sum" "$host_cpu" "$host_mem"
  [[ $vcpu_sum -le $host_cpu ]] && ok "vCPU 未超額" || bad "vCPU 超額配置"
  [[ $mem_sum -le $host_mem ]] && ok "記憶體未超額" || bad "記憶體超額配置"

  [[ $fail -eq 0 ]] || die "檢查未通過"
  info "全部通過"
}

# ── render ──────────────────────────────────────────────────────────
cmd_render() { load_global; with_lock; do_render "$@"; }

# ── ls ──────────────────────────────────────────────────────────────
cmd_ls() {
  load_global
  printf '%-16s %-10s %-14s %-12s %s\n' "NAME" "STATE" "IP" "VCPU/RAM" "UPSTREAM"
  local name dom ip
  for name in $(vm_names); do
    load_vm "$name"
    dom="$(virsh domstate "$name" 2>/dev/null | head -1 || true)"
    ip="$(vm_ip "$name")"
    printf '%-16s %-10s %-14s %-12s %s\n' \
      "$name" "${dom:--}" "${ip:--}" "${VCPU}c/${MEM_GB}G" "$UPSTREAM_HOST:$UPSTREAM_PORT"
  done
}

# ── image ───────────────────────────────────────────────────────────
cmd_image() {
  load_global
  require_root image
  local cache="$DISK_DIR/cache"
  local base="$cache/$(basename "$IMAGE_URL")"
  mkdir -p "$cache" "$DISK_DIR"

  if [[ ! -f $base ]]; then
    info "下載基礎映像（約 600MB）"
    curl -fL --retry 3 -o "$base.part" "$IMAGE_URL"
    mv "$base.part" "$base"
  else
    info "基礎映像已存在：$base"
  fi

  local name
  for name in "$@"; do
    [[ $name == --all ]] && continue
    load_vm "$name"
    if [[ -f $DISK_PATH ]]; then
      info "$name: 磁碟已存在，略過"
    else
      info "$name: 建立 ${DISK_SIZE_GB}G 稀疏 qcow2"
      qemu-img create -f qcow2 -F qcow2 -b "$base" "$DISK_PATH" "${DISK_SIZE_GB}G"
    fi
  done
}

# ── network（全域）──────────────────────────────────────────────────
cmd_network() {
  load_global
  require_root network
  require_rendered

  if virsh net-info "$NET_NAME" >/dev/null 2>&1; then
    info "網路已定義：$NET_NAME"
  else
    info "定義網路：$NET_NAME"
    virsh net-define "$OUT/shared/network.xml" >/dev/null
  fi

  if virsh net-info "$NET_NAME" | grep -q '^Active:.*yes'; then
    info "網路已啟動"
  else
    virsh net-start "$NET_NAME" >/dev/null
    info "網路已啟動"
  fi
  virsh net-autostart "$NET_NAME" >/dev/null

  # 逐台補上靜態 DHCP 綁定。用 net-update 而非重啟網路，
  # 否則新增一台 VM 會把既有 VM 的連線一起打斷。
  local name
  for name in $(vm_names); do
    load_vm "$name"
    if [[ $VM_MAC_MODE == random ]]; then
      # 由 MAC 綁定遷移而來時，先移除同一 IP 的舊 host 項目，避免
      # dnsmasq 對同一位址有兩個 reservation。新項目只以 hostname 識別。
      local old_host
      old_host="$(virsh net-dumpxml "$NET_NAME" 2>/dev/null | \
        grep "<host " | grep -F "ip='$VM_IP'" | head -1 | sed 's/^[[:space:]]*//')"
      if [[ -n $old_host && $old_host == *"mac="* ]]; then
        virsh net-update "$NET_NAME" delete ip-dhcp-host "$old_host" --live --config >/dev/null 2>&1 \
          || die "$name: 無法移除舊的 MAC DHCP 綁定"
      fi
      if virsh net-dumpxml "$NET_NAME" 2>/dev/null | grep '<host ' | \
           grep -F "name='$GUEST_HOSTNAME'" | grep -F "ip='$VM_IP'" | grep -qv 'mac='; then
        continue
      fi
      if virsh net-update "$NET_NAME" add ip-dhcp-host \
           "<host name='$GUEST_HOSTNAME' ip='$VM_IP'/>" --live --config >/dev/null 2>&1; then
        info "$name: 已按 hostname 綁定 $VM_IP（MAC 可輪替）"
      else
        die "$name: 無法建立 hostname DHCP 綁定"
      fi
      continue
    fi
    if virsh net-dumpxml "$NET_NAME" 2>/dev/null | grep -qi "mac='$VM_MAC'"; then
      continue
    fi
    if virsh net-update "$NET_NAME" add ip-dhcp-host \
         "<host mac='$VM_MAC' name='$GUEST_HOSTNAME' ip='$VM_IP'/>" --live --config >/dev/null 2>&1; then
      info "$name: 已綁定 $VM_IP"
    else
      echo "  (略過 $name 的 DHCP 綁定，可能已存在)"
    fi
  done

  ip -br addr show "$BRIDGE" || die "$BRIDGE 未出現"
}

# ── gateway（per-VM 實例 + 全域管線）────────────────────────────────
cmd_gateway() {
  load_global
  require_root gateway
  require_rendered

  id approx-gw >/dev/null 2>&1 || {
    info "建立系統使用者 approx-gw"
    useradd --system --no-create-home --shell /usr/sbin/nologin approx-gw
  }

  info "安裝全域管線"
  install -d -m 0755 /etc/approx-gateway /usr/local/libexec
  install -m 0755 "$CORE_BIN" /usr/local/bin/approx-mihomo
  install -m 0644 "$OUT/shared/approx-gw.nft"    /etc/approx-gateway/approx-gw.nft
  install -m 0644 "$OUT/shared/approx-gw.sysctl" /etc/approx-gateway/approx-gw.sysctl
  install -m 0755 "$OUT/shared/systemd/approx-gateway-net" /usr/local/libexec/approx-gateway-net
  install -m 0644 "$OUT/shared/systemd/approx-gateway-net.service" /etc/systemd/system/
  install -m 0644 "$OUT/shared/systemd/approx-gateway@.service"    /etc/systemd/system/

  # UFW 的 base chain 在 nft 的 accept 之後仍會評估，會在 filter 優先級
  # 把 VM 網段的輸入再 DROP 一次。讓 UFW 對整個網橋放行，
  # 實際過濾由本專案的 nft 表負責（它跑在 filter-10，會先 drop 掉不該放行的）。
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; then
    if ! ufw status 2>/dev/null | grep -q "on $BRIDGE"; then
      ufw allow in on "$BRIDGE" >/dev/null
      info "UFW：已放行 $BRIDGE"
    fi
  fi

  systemctl daemon-reload
  systemctl enable approx-gateway-net.service
  systemctl restart approx-gateway-net.service

  local name
  for name in "$@"; do
    [[ $name == --all ]] && continue
    load_vm "$name"
    info "安裝網關實例：$name"
    install -d -m 0755 "/etc/approx-gateway/$name"
    install -d -m 0700 -o approx-gw -g approx-gw "/var/lib/approx-gateway/$name"
    install -m 0600 -o approx-gw -g approx-gw "$OUT/vms/$name/mihomo/config.yaml" \
            "/etc/approx-gateway/$name/config.yaml"
    systemctl enable "approx-gateway@$name.service"
    systemctl restart "approx-gateway@$name.service"
    sleep 1
    systemctl --no-pager --lines=0 status "approx-gateway@$name.service" >/dev/null \
      || die "$name: approx-gateway@$name 啟動失敗"
  done
}

# ── vm ──────────────────────────────────────────────────────────────
cmd_vm() {
  load_global
  require_root vm
  require_rendered
  local name="$1" redefine="${2:-}"
  load_vm "$name"

  info "產生 cloud-init seed：$name"
  cloud-localds "$SEED_PATH" "$OUT/vms/$name/cloud-init/user-data.yaml" \
                "$OUT/vms/$name/cloud-init/meta-data"

  local domain_xml="$OUT/vms/$name/domain.xml" random_xml=""
  if [[ $VM_MAC_MODE == random ]] && ! virsh dominfo "$VM_NAME" >/dev/null 2>&1; then
    local boot_mac
    boot_mac="$(random_mac)"
    random_xml="$(mktemp)"
    sed "s/$VM_MAC/$boot_mac/g" "$domain_xml" >"$random_xml"
    domain_xml="$random_xml"
    info "$name: 初始化使用隨機 MAC $boot_mac"
  elif [[ $VM_MAC_MODE == random && $redefine == --redefine ]]; then
    # 強制重定義也必須保留初始化時的 MAC，不能把 placeholder 寫回去。
    local existing_mac
    existing_mac="$(virsh dumpxml "$VM_NAME" | sed -n "s/.*<mac address=['\"]\([^'\"]*\)['\"].*/\1/p" | head -1)"
    [[ $existing_mac =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] \
      || die "$name: 無法從既有 domain 讀取 MAC"
    random_xml="$(mktemp)"
    sed "s/$VM_MAC/${existing_mac,,}/g" "$domain_xml" >"$random_xml"
    domain_xml="$random_xml"
  fi

  if virsh dominfo "$VM_NAME" >/dev/null 2>&1; then
    if [[ $redefine == --redefine ]]; then
      info "重新定義 domain：$VM_NAME"
      virsh define "$domain_xml" >/dev/null
    else
      info "domain 已存在：$VM_NAME"
    fi
  else
    info "定義 domain：$VM_NAME"
    virsh define "$domain_xml" >/dev/null
  fi
  [[ -z $random_xml ]] || rm -f "$random_xml"

  if virsh domstate "$VM_NAME" | grep -q running; then
    info "VM 已在運行"
  else
    virsh start "$VM_NAME" >/dev/null
    info "VM 已啟動"
  fi

  echo
  echo "首次開機 cloud-init 需下載套件與安裝 Claude Code，約 3-8 分鐘。"
  echo "追蹤進度：  sudo virsh console $VM_NAME      （Ctrl+] 離開）"
  echo "或從宿主：  ssh -i $KEYS/$name -o UserKnownHostsFile=$KEYS/$name.known_hosts $GUEST_USER@${VM_IP}"
}

cmd_up() {
  local names=("$@") name
  cmd_render
  if [[ ${#names[@]} -eq 0 ]]; then
    names=(--all)
  fi
  local expand=()
  for name in "${names[@]}"; do
    if [[ $name == --all ]]; then
      expand+=($(vm_names))
    else
      expand+=("$name")
    fi
  done
  cmd_image "${expand[@]}"
  cmd_network
  cmd_gateway "${expand[@]}"
  for name in "${expand[@]}"; do
    cmd_vm "$name"
  done
}

# ── 生命週期 ────────────────────────────────────────────────────────
cmd_status() {
  load_global
  local net
  net="$(virsh net-info "$NET_NAME" 2>/dev/null | awk '/^Active/{print $2}' || true)"
  printf '%-14s %s\n' "network:" "${net:--}"
  printf '%-14s %s\n' "net-unit:" "$(systemctl is-active approx-gateway-net.service 2>/dev/null || true)"
  printf '%-14s %s\n' "bridge:" "$(ip -br addr show "$BRIDGE" 2>/dev/null | awk '{print $3}' || true)"
  if sudo -n nft list table ip approx_gw >/dev/null 2>&1; then
    printf '%-14s %s\n' "nft:" "loaded"
  else
    printf '%-14s %s\n' "nft:" "-"
  fi
  echo
  local name
  for name in $(vm_names); do
    printf '%-14s dom=%s gw=%s ip=%s\n' "$name" \
      "$(virsh domstate "$name" 2>/dev/null | head -1 || echo -)" \
      "$(systemctl is-active "approx-gateway@$name.service" 2>/dev/null || true)" \
      "$(vm_ip "$name" || true)"
  done
}

cmd_start()   { load_global; require_root start;   local n; n="$(resolve_vm "${1:-}")"; load_vm "$n"; virsh start "$VM_NAME"; }
cmd_stop()    { load_global; require_root stop;    local n; n="$(resolve_vm "${1:-}")"; load_vm "$n"; virsh shutdown "$VM_NAME" || virsh destroy "$VM_NAME"; }
cmd_console() { load_global; require_root console; local n; n="$(resolve_vm "${1:-}")"; load_vm "$n"; virsh console "$VM_NAME"; }

cmd_sshkey() {
  load_global
  local n
  n="$(resolve_vm "${1:-}")"
  vm_ssh "$n" 'cat ~/.ssh/id_ed25519.pub' \
    || die "取不到公鑰（VM 未開機或 cloud-init 尚未完成；若 ~/.ssh 由宿主掛載，客體不產生自己的金鑰）"
}

cmd_destroy() {
  load_global
  require_root destroy
  local name="${1:-}" purge=0
  if [[ ${1:-} == --purge ]]; then
    purge=1; name="${2:-}"
  elif [[ ${2:-} == --purge ]]; then
    purge=1
  fi
  name="$(resolve_vm "$name")"
  load_vm "$name"

  if virsh domstate "$VM_NAME" >/dev/null 2>&1; then
    virsh destroy "$VM_NAME" >/dev/null 2>&1 || true
    virsh undefine "$VM_NAME" --nvram >/dev/null 2>&1 \
      || virsh undefine "$VM_NAME" >/dev/null 2>&1 || true
    info "domain 已移除：$VM_NAME"
  fi

  systemctl disable --now "approx-gateway@$name.service" 2>/dev/null || true
  rm -rf "/etc/approx-gateway/$name" "/var/lib/approx-gateway/$name"
  info "網關實例已移除：$name"

  # 重繪 nft：把該台的 saddr 規則拿掉，其餘 VM 不受影響
  if [[ -d $OUT/shared ]]; then
    do_render --only shared >/dev/null
    install -m 0644 "$OUT/shared/approx-gw.nft" /etc/approx-gateway/approx-gw.nft 2>/dev/null || true
    nft -f /etc/approx-gateway/approx-gw.nft 2>/dev/null || true
    info "nft 規則已重繪"
  fi

  rm -f "$SEED_PATH"
  if [[ $purge -eq 1 ]]; then
    rm -f "$DISK_PATH"
    rm -f "$KEYS/$name" "$KEYS/$name.pub" "$KEYS/$name.known_hosts"
    info "磁碟與金鑰已刪除：$DISK_PATH"
  else
    echo "磁碟保留在 $DISK_PATH（要一併刪除加 --purge）"
  fi
}

cmd_teardown() {
  load_global
  require_root teardown
  local name
  for name in $(vm_names); do
    systemctl disable --now "approx-gateway@$name.service" 2>/dev/null || true
  done
  systemctl disable --now approx-gateway-net.service 2>/dev/null || true
  rm -rf /etc/approx-gateway /var/lib/approx-gateway /usr/local/bin/approx-mihomo
  rm -f /usr/local/libexec/approx-gateway-net \
        /etc/systemd/system/approx-gateway@.service \
        /etc/systemd/system/approx-gateway-net.service
  systemctl daemon-reload
  info "網關與管線已移除"

  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "on $BRIDGE"; then
    ufw delete allow in on "$BRIDGE" >/dev/null 2>&1 || true
  fi

  virsh net-destroy "$NET_NAME" >/dev/null 2>&1 || true
  virsh net-undefine "$NET_NAME" >/dev/null 2>&1 || true
  info "網路已移除（VM 磁碟與定義保留，用 destroy 逐台處理）"
}

# ── verify ──────────────────────────────────────────────────────────
cmd_verify() {
  load_global
  local fail=0
  ok()  { printf '  \033[32m✓\033[0m %s\n' "$*"; }
  bad() { printf '  \033[31m✗\033[0m %s\n' "$*"; fail=1; }

  info "全域"
  systemctl is-active --quiet approx-gateway-net.service && ok "approx-gateway-net 運行中" || bad "approx-gateway-net 未運行"
  sudo -n nft list table ip approx_gw >/dev/null 2>&1 && ok "nft 規則已載入" || bad "nft 規則缺失"
  ip rule show | grep -q 'fwmark 0x1 lookup 100' && ok "策略路由" || bad "策略路由缺失"
  sysctl -n "net.ipv4.conf.$BRIDGE.route_localnet" 2>/dev/null | grep -q 1 \
    && ok "route_localnet" || bad "route_localnet 未開啟"

  local targets=()
  if [[ $# -gt 0 ]]; then targets=("$@"); else mapfile -t targets < <(vm_names); fi

  local name
  for name in "${targets[@]}"; do
    load_vm "$name"
    info "$name"
    systemctl is-active --quiet "approx-gateway@$name.service" \
      && ok "approx-gateway@$name 運行中" || bad "approx-gateway@$name 未運行"
    if vm_ssh "$name" true 2>/dev/null; then
      ok "SSH 可達（$VM_IP）"
      local ip
      ip="$(vm_ssh "$name" 'curl -s --max-time 10 https://api.ipify.org' 2>/dev/null || true)"
      [[ -n $ip ]] && ok "出口 IP: $ip" || bad "出口 IP 取得失敗"
      vm_ssh "$name" 'dig +short api.anthropic.com | head -1' 2>/dev/null | grep -qv '^198\.18\.' \
        && ok "DNS 非 fake-ip" || bad "DNS 疑似 fake-ip"
    else
      bad "SSH 不可達（VM 未開機或 cloud-init 未完成）"
    fi
  done

  # 跨 VM：出口 IP 必須不同，否則「每台獨立出口」沒有實現
  if [[ ${#targets[@]} -gt 1 ]]; then
    info "跨 VM 差異"
    local ips="" dups
    for name in "${targets[@]}"; do
      ips+="$(vm_ssh "$name" 'curl -s --max-time 10 https://api.ipify.org' 2>/dev/null || echo "?")"$'\n'
    done
    dups="$(printf '%s' "$ips" | grep -v '^?$' | sort | uniq -d)"
    [[ -z $dups ]] && ok "出口 IP 各不相同" || bad "出口 IP 重複：$dups"

    local mids=""
    for name in "${targets[@]}"; do
      mids+="$(vm_ssh "$name" 'jq -r .machineID ~/.claude.json 2>/dev/null || echo "?"')"$'\n'
    done
    dups="$(printf '%s' "$mids" | grep -v '^?$' | sort | uniq -d)"
    [[ -z $dups ]] && ok "machineID 各不相同" || bad "machineID 重複：$dups"
  fi

  [[ $fail -eq 0 ]] && info "驗證通過" || die "驗證未通過"
}

# ── audit ───────────────────────────────────────────────────────────
# 身分盤點：每台客體的裝置／帳號指紋、跨 VM 重複、宿主與共用掛載的污染。
# 全程只讀，不改任何狀態。
audit_guest() {
  vm_ssh "$1" bash -s <<'GUEST'
set -u
j() { jq -r "$1 // \"-\"" "$HOME/.claude.json" 2>/dev/null || echo "-"; }
echo "hostname=$(hostname 2>/dev/null || echo -)"
echo "machine_id=$(cat /etc/machine-id 2>/dev/null || echo -)"
v="$("$HOME/.local/bin/claude" --version 2>/dev/null | awk '{print $1}' | head -1)"
[ -n "$v" ] || v="$(claude --version 2>/dev/null | awk '{print $1}' | head -1)"
echo "version=${v:--}"
if [ -f "$HOME/.claude.json" ]; then
  echo "user_id=$(j .userID)"
  echo "machine_uid=$(j .machineID)"
  echo "oauth_email=$(j .oauthAccount.emailAddress)"
  echo "oauth_acct=$(j .oauthAccount.accountUuid)"
else
  echo "user_id=-"; echo "machine_uid=-"; echo "oauth_email=-"; echo "oauth_acct=-"
fi
echo "creds=$([ -f "$HOME/.claude/.credentials.json" ] && echo yes || echo no)"
echo "cfg_backup=$([ -f "$HOME/.claude.json.backup" ] && echo yes || echo no)"
echo "dot_kb=$(du -sk "$HOME/.claude" 2>/dev/null | cut -f1 || echo 0)"
echo "projects=$(find "$HOME/.claude/projects" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l | tr -d ' ')"
echo "hist=$(( $(wc -l < "$HOME/.bash_history" 2>/dev/null || echo 0) + $(wc -l < "$HOME/.zsh_history" 2>/dev/null || echo 0) ))"
echo "git=$(git config --global user.email 2>/dev/null || echo -)"
GUEST
}

cmd_audit() {
  require_root audit
  load_global
  local -a targets=()
  if [[ $# -gt 0 ]]; then targets=("$@"); else mapfile -t targets < <(vm_names); fi
  local tmp fail=0 name key val
  tmp="$(mktemp -d)"
  field() { grep -m1 "^$1=" "$tmp/$name" | cut -d= -f2-; }

  info "客體身分指紋"
  printf '  %-14s %-30s %-10s %-10s %-9s %7s %5s %5s\n' \
         "VM" "帳號" "userID" "machineID" "版本" ".claude" "session" "歷史"
  for name in "${targets[@]}"; do
    if ! vm_ssh "$name" true 2>/dev/null; then
      printf '  %-14s %s\n' "$name" "（SSH 不可達）"; fail=1; continue
    fi
    audit_guest "$name" > "$tmp/$name" 2>/dev/null || true
    printf '  %-14s %-30s %-10s %-10s %-9s %6sK %5s %5s\n' \
      "$name" "$(field oauth_email)" "$(field user_id | cut -c1-8)" \
      "$(field machine_uid | cut -c1-8)" "$(field version)" \
      "$(field dot_kb)" "$(field projects)" "$(field hist)"
  done

  info "跨 VM 重複"
  local kdup
  for key in user_id machine_uid oauth_email machine_id hostname; do
    local -A seen=()
    kdup=0
    for name in "${targets[@]}"; do
      [[ -s $tmp/$name ]] || continue
      val="$(field "$key")"
      [[ -n $val && $val != "-" ]] || continue
      if [[ -n ${seen[$val]:-} ]]; then
        printf '  \033[31m✗\033[0m %s 相同：%s / %s（%s）\n' "$key" "${seen[$val]}" "$name" "$val"
        kdup=1
      else
        seen[$val]="$name"
      fi
    done
    if [[ $kdup -eq 0 ]]; then
      printf '  \033[32m✓\033[0m %s 各不相同\n' "$key"
    else
      fail=1
    fi
  done

  # 舊帳號的字串殘留在 transcript / history 裡，代表這台曾經用過別的帳號
  local emails="" e
  for name in "${targets[@]}"; do
    [[ -s $tmp/$name ]] || continue
    e="$(field oauth_email)"
    [[ -n $e && $e != "-" ]] && emails+="$e"$'\n'
  done
  emails="$(printf '%s' "$emails" | sort -u)"
  if [[ -n $emails ]]; then
    for name in "${targets[@]}"; do
      [[ -s $tmp/$name ]] || continue
      e="$(field oauth_email)"
      while read -r other; do
        [[ -z $other || $other == "$e" ]] && continue
        if vm_ssh "$name" "timeout 15 grep -rlF '$other' \"\$HOME/.claude\" 2>/dev/null | head -1" 2>/dev/null | grep -q .; then
          printf '  \033[31m✗\033[0m %s 的 ~/.claude 內殘留其他帳號字串：%s\n' "$name" "$other"
          fail=1
        fi
      done <<< "$emails"
    done
  fi

  info "宿主"
  local hh he= logged=0
  hh="$(getent passwd "${SUDO_USER:-root}" 2>/dev/null | cut -d: -f6)"
  if [[ -n $hh && -f $hh/.claude.json ]]; then
    he="$(jq -r '.oauthAccount.emailAddress // empty' "$hh/.claude.json" 2>/dev/null || true)"
    [[ -f $hh/.claude/.credentials.json || -n $he ]] && logged=1
    if [[ $logged -eq 1 ]]; then
      printf '  \033[33m!\033[0m %s 已登入 Claude（%s）：新帳號不得在宿主執行，宿主家目錄也不得掛進 VM\n' \
             "$hh" "${he:-有憑證}"
    else
      printf '  \033[33m!\033[0m %s 有 Claude 設定但未登入；仍不建議在宿主執行新帳號\n' "$hh"
    fi
  else
    printf '  \033[32m✓\033[0m 宿主未持有 Claude 身分\n'
  fi

  info "共用掛載"
  local src vm tag hits
  while IFS=$'\t' read -r vm src tag; do
    [[ -d $src ]] || continue
    # ~/.ssh 依 D15 明示共用：config、私鑰、known_hosts 都掛進客體，
    # SSH 身分不再是每台獨立。這是使用者選的取捨，列為警告而非失敗。
    if [[ $tag == ssh ]]; then
      printf '  \033[33m!\033[0m %s ← %s（SSH 金鑰與 config 共用，D15 明示取捨）\n' "$vm" "$src"
      continue
    fi
    hits="$(find "$src" -maxdepth 2 \( -name .claude.json -o -name .credentials.json \
              -o -name .git-credentials -o -name .netrc \) 2>/dev/null | head -3)"
    if [[ -n $hits ]]; then
      printf '  \033[31m✗\033[0m %s 掛載 %s 內含身分檔：\n' "$vm" "$src"
      printf '      %s\n' $hits
      fail=1
    else
      printf '  \033[32m✓\033[0m %s ← %s（無身分檔）\n' "$vm" "$src"
    fi
  done < <(do_render --mounts)

  rm -rf "$tmp"
  [[ $fail -eq 0 ]] && info "身分盤點通過" || die "身分盤點發現問題，見上方標記"
}

# ── reset ───────────────────────────────────────────────────────────
# 把一台客體恢復成「從未登入過 Claude」的狀態。只動客體內的使用者資料，
# 不動 workspace 掛載、工具鏈與磁碟映像。
cmd_reset() {
  require_root reset
  load_global
  local name="" yes=0 rotate=0 scrub_git=0 a ans
  for a in "$@"; do
    case "$a" in
      -y|--yes)       yes=1 ;;
      --rotate-ssh)   rotate=1 ;;
      --scrub-git)    scrub_git=1 ;;
      -h|--help)      echo "用法：claude-vm reset [name] [--yes] [--rotate-ssh] [--scrub-git]"; return 0 ;;
      -*)             die "未知選項：$a" ;;
      *)              name="$a" ;;
    esac
  done
  name="$(resolve_vm "$name")"
  load_vm "$name"
  vm_ssh "$name" true 2>/dev/null || die "SSH 不可達：$name（VM 未開機？）"

  if [[ $yes -ne 1 ]]; then
    info "即將淨化 $name"
    cat <<EOF
  清除  ~/.claude（含 projects/transcripts、history、statsig、credentials）
        ~/.claude.json、~/.claude.json.backup、~/.config/claude
        shell 歷史（bash／zsh／fish／PSReadLine）
EOF
    [[ $rotate -eq 1 ]]   && echo "  重產  ~/.ssh/id_ed25519（~/.ssh 若由宿主掛載則略過）"
    [[ $scrub_git -eq 1 ]] && echo "  回填  ~/.gitconfig ← /etc/claude-vm/gitconfig"
    echo "  不動  workspace 掛載內容、工具鏈、磁碟映像"
    printf '輸入 VM 名稱確認：'
    read -r ans
    [[ $ans == "$name" ]] || die "已取消"
  fi

  vm_ssh "$name" bash -s -- "$rotate" "$scrub_git" <<'GUEST'
set -u
rotate="${1:-0}"; scrub_git="${2:-0}"
# 只殺真正的 claude 行程。用 -f 'claude' 會連 sshd 的 "claude@notty" 一起殺，
# 連線會在清理前斷掉。
pkill -u "$(id -un)" -x claude 2>/dev/null || true
pkill -u "$(id -un)" -f '/claude/versions/' 2>/dev/null || true
sleep 1
rm -rf "$HOME/.claude" "$HOME/.claude.json" "$HOME/.claude.json.backup" \
       "$HOME/.config/claude" "$HOME/.config/claude-code" \
       "$HOME/.local/state/claude" 2>/dev/null || true
rm -rf "$HOME"/.cache/claude* 2>/dev/null || true
for f in "$HOME/.bash_history" "$HOME/.zsh_history" \
         "$HOME/.local/share/fish/fish_history" \
         "$HOME/.config/powershell/PSReadLine/ConsoleHost_history.txt"; do
  [ -e "$f" ] && : > "$f"
done
if [ "$scrub_git" = 1 ]; then
  rm -f "$HOME/.gitconfig"
  [ -f /etc/claude-vm/gitconfig ] && install -m 0644 /etc/claude-vm/gitconfig "$HOME/.gitconfig"
fi
if [ "$rotate" = 1 ]; then
  # ~/.ssh 由宿主目錄掛載時，這裡的 rm 會刪到宿主的金鑰。跳過並說明。
  if [ "$(findmnt -n -o FSTYPE --target "$HOME/.ssh" 2>/dev/null || true)" = virtiofs ]; then
    echo "reset-note: ~/.ssh 由宿主掛載，略過金鑰重產"
  else
    rm -f "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_ed25519.pub"
  fi
fi
echo "reset-done"
GUEST

  info "$name 已淨化；下次啟動 claude 會產生新的 userID／machineID"
}

cmd_help() {
  cat <<'USAGE'
claude-vm — 部署走透明代理的 Claude Code 虛擬機（可多台）

用法：bin/claude-vm <command> [args]

commands:
  init                    建立 config.yaml
  check                   檢查主機前置條件與資源
  render [--only SCOPE]   只渲染部署產物（shared 或 VM 名）
  ls                      列出 VM 與狀態
  image <name...|--all>   下載映像並建立 qcow2
  network                 建立 libvirt 網路（全域）
  gateway <name...|--all> 安裝並啟動網關實例
  vm <name> [--redefine]  cloud-init seed + 定義並啟動 VM
  up [name...|--all]      render → image → network → gateway → vm
  status                  全域與各台狀態
  start/stop/console [name]
  sshkey [name]           印出該台客體自己產生的 SSH 公鑰
  verify [name...]        部署後驗證（含跨 VM 差異檢查）
  audit [name...]         身分盤點：指紋、跨 VM 重複、宿主與掛載污染（只讀）
  reset [name] [--yes] [--rotate-ssh] [--scrub-git]
                          淨化客體身分狀態，回到「從未登入」
  destroy <name> [--purge]  只拆該台
  teardown                拆除全域層（網路、網關、nft）
USAGE
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    init) cmd_init "$@" ;;
    check) cmd_check "$@" ;;
    render) cmd_render "$@" ;;
    ls) cmd_ls "$@" ;;
    image) cmd_image "$@" ;;
    network) cmd_network "$@" ;;
    gateway) cmd_gateway "$@" ;;
    vm) cmd_vm "$@" ;;
    up) cmd_up "$@" ;;
    status) cmd_status "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    console) cmd_console "$@" ;;
    sshkey) cmd_sshkey "$@" ;;
    verify) cmd_verify "$@" ;;
    audit) cmd_audit "$@" ;;
    reset) cmd_reset "$@" ;;
    destroy) cmd_destroy "$@" ;;
    teardown) cmd_teardown "$@" ;;
    help|-h|--help) cmd_help ;;
    *) die "未知命令：$cmd（執行 $0 help）" ;;
  esac
}

main "$@"
